{% extends 'best-sellers/_layouts/reports' %}

{% set title = 'nav.customers'|t('best-sellers') %}
{% set selectedSubnavItem = 'customers' %}

{% block reportContent %}
	{# Filters #}
	<div class="bs-filter-bar bs-filter-bar--spaced">
		<div class="bs-multiselect" id="customer-type-multiselect">
			<button type="button" class="bs-multiselect__btn" data-label="{{ 'customers.filter.customerType'|t('best-sellers') }}">{{ 'customers.filter.customerType'|t('best-sellers') }}</button>
			<div class="bs-multiselect__dropdown">
				<label><input type="checkbox" value="credentialed"> {{ 'customers.filter.credentialed'|t('best-sellers') }}</label>
				<label><input type="checkbox" value="guest"> {{ 'customers.filter.guest'|t('best-sellers') }}</label>
			</div>
		</div>
		<div class="bs-filter-bar__item">
			<input type="text" id="customer-search" class="text fullwidth" placeholder="{{ 'customers.filter.searchPlaceholder'|t('best-sellers') }}" autocomplete="off">
		</div>
		<span id="customers-export"></span>
	</div>

	{# Loading State #}
	<div id="customers-loading" class="bs-loading">
		<div class="bs-loading__spinner"></div>
		<p class="bs-loading__message">{{ 'customers.loading'|t('best-sellers') }}</p>
	</div>

	{# Customers Table (hidden until loaded) #}
	<div id="customers-container" class="hidden">
		<div id="customers-totals" class="bs-totals-bar" hidden></div>
		<div style="overflow-x: auto;">
			<table class="bs-data-table" id="customers-table">
				<thead>
					<tr>
						<th data-sort="email">{{ 'Email'|t('app') }}</th>
						<th data-sort="status">{{ 'Status'|t('app') }}</th>
						<th class="bs-data-table--right" data-sort="orderCount">{{ 'customers.col.orderCount'|t('best-sellers') }}</th>
						<th class="bs-data-table--right" data-sort="totalSpent">{{ 'customers.col.totalSpent'|t('best-sellers') }}</th>
						<th class="bs-data-table--right" data-sort="aov">{{ 'kpi.aov'|t('best-sellers') }}</th>
						<th data-sort="lastOrder">{{ 'customers.col.lastPurchase'|t('best-sellers') }}</th>
					</tr>
				</thead>
				<tbody id="customers-tbody"></tbody>
			</table>
		</div>
		<div id="customers-pagination" class="bs-pagination"></div>

		<details class="bs-data-notes">
			<summary>{{ 'table.aboutTheseNumbers'|t('best-sellers') }}</summary>
			<ul>
				<li>{{ 'customers.notes.grouping'|t('best-sellers') }}</li>
				<li>{{ 'customers.notes.totalSpent'|t('best-sellers', { label: '<strong>' ~ 'customers.col.totalSpent'|t('best-sellers') ~ '</strong>' })|raw }}</li>
				<li>{{ 'customers.notes.aov'|t('best-sellers', { label: '<strong>' ~ 'kpi.aov'|t('best-sellers') ~ '</strong>', totalSpent: '<strong>' ~ 'customers.col.totalSpent'|t('best-sellers') ~ '</strong>', orderCount: '<strong>' ~ 'customers.col.orderCount'|t('best-sellers') ~ '</strong>' })|raw }}</li>
				<li>{{ 'customers.notes.onlyCompleted'|t('best-sellers') }}</li>
				<li>{{ 'sales.notes.timezone'|t('best-sellers', { tz: craft.app.getTimeZone() }) }}</li>
			</ul>
		</details>
	</div>
{% endblock %}

{% js %}
document.addEventListener('DOMContentLoaded', function () {
	const searchInput = document.getElementById('customer-search');
	let searchTimer = null;

	const customerTypeMulti = BestSellersReports.createMultiSelect({
		container: document.getElementById('customer-type-multiselect'),
		onChange: function () { table.reload(); }
	});

	const table = BestSellersReports.createAjaxTable({
		loadingEl: document.getElementById('customers-loading'),
		containerEl: document.getElementById('customers-container'),
		tbodyEl: document.getElementById('customers-tbody'),
		paginationEl: document.getElementById('customers-pagination'),
		totalsEl: document.getElementById('customers-totals'),
		actionUrl: 'best-sellers/customers/customers-data',
		exportUrl: 'best-sellers/customers/export-csv',
		exportContainerEl: document.getElementById('customers-export'),
		baseParams: { from: '{{ from }}', to: '{{ to }}', preset: '{{ preset }}' },
		defaultSort: 'totalSpent',
		defaultSortDir: 'desc',
		itemLabel: 'customers',
		emptyMessage: '{{ "customers.empty"|t("best-sellers") }}',
		buildRow: function (customer) {
			const row = document.createElement('tr');
			const emailCell = customer.cpUrl
				? '<a href="' + customer.cpUrl + '" class="go">' + customer.email + '</a>'
				: customer.email;

			const statusColors = { credentialed: 'green', guest: '' };
			const statusLabels = {
				credentialed: '{{ "customers.filter.credentialed"|t("best-sellers") }}',
				guest: '{{ "customers.filter.guest"|t("best-sellers") }}'
			};
			const statusColor = statusColors[customer.status] || '';
			const statusLabel = statusLabels[customer.status] || customer.status;
			const statusCell = '<span class="status ' + statusColor + '"></span> ' + statusLabel;

			row.innerHTML =
				'<td>' + emailCell + '</td>' +
				'<td>' + statusCell + '</td>' +
				'<td class="bs-data-table--right">' + customer.orderCount + '</td>' +
				'<td class="bs-data-table--right">' + customer.totalSpent + '</td>' +
				'<td class="bs-data-table--right">' + customer.aov + '</td>' +
				'<td>' + customer.lastOrder + '</td>';
			return row;
		},
		buildTotalsBar: function (totals) {
			return BestSellersReports.buildTotalsBar(
				'{{ "table.filteredResultsTotal"|t("best-sellers") }}',
				[
					{ label: '{{ "Orders"|t("commerce") }}', value: totals.orderCount },
					{ label: '{{ "customers.col.totalSpent"|t("best-sellers") }}', value: totals.totalSpent }
				]
			);
		},
		getFilterParams: function () {
			const params = {};
			const searchValue = searchInput ? searchInput.value.trim() : '';
			if (searchValue) { params.search = searchValue; }
			const customerTypes = customerTypeMulti.getSelected();
			if (customerTypes.length > 0) { params['customerType[]'] = customerTypes; }
			return params;
		},
		restoreFilterState: function (filters) {
			if (filters.search && searchInput) { searchInput.value = filters.search; }
			if (filters['customerType[]']) {
				const customerTypeContainer = document.getElementById('customer-type-multiselect');
				const customerTypeCheckboxes = customerTypeContainer.querySelectorAll('input[type="checkbox"]');
				const customerTypeValues = filters['customerType[]'];
				customerTypeCheckboxes.forEach(function (checkbox) {
					checkbox.checked = customerTypeValues.indexOf(checkbox.value) !== -1;
				});
				customerTypeMulti.refresh();
			}
		}
	});

	if (searchInput) {
		searchInput.addEventListener('input', function () {
			clearTimeout(searchTimer);
			searchTimer = setTimeout(function () { table.reload(); }, 400);
		});
	}

	table.init();
});
{% endjs %}
