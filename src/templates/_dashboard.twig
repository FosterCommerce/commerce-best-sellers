{% extends '_layouts/cp' %}
{% import "_includes/forms" as forms %}

{% set title = 'nav.bestSellers'|t('best-sellers') ~ ' - ' ~ title %}
{% set selectedSubnavItem = 'dashboard' %}

{% set additionalButtons %}
	<form id="filter-form" method="get" style="display: flex; flex-direction: row; column-gap: 1rem;">
		<div style="flex: 1;">
			{{ forms.selectField({
				first: true,
				id: 'products-or-variants',
				name: 'productsOrVariants',
				options: [
					{ label: 'Products'|t('commerce'), value: 'products' },
					{ label: 'Variants'|t('commerce'), value: 'variants' },
				],
				toggle: true,
				value: productsOrVariants,
			}) }}
		</div>

		{% set productTypes = [{
			label: 'dashboard.allProductTypes'|t('best-sellers'),
			value: 'all',
		}]|merge(craft.commerce.productTypes.allProductTypes|map(type => {
			label: type.name,
			value: type.handle,
		})) %}
		<div style="flex: 1;">
			{{ forms.selectField({
				first: true,
				id: 'product-type',
				name: 'productType',
				options: productTypes,
				toggle: true,
				value: productType,
			}) }}
		</div>

		<div style="flex: 1;">
			<select id="date-presets" class="text fullwidth">
				<option value="">{{ 'reports.preset.placeholder'|t('best-sellers') }}</option>
				<option value="today" {% if preset == 'today' %}selected{% endif %}>{{ 'Today'|t('app') }}</option>
				<option value="thisWeek" {% if preset == 'thisWeek' %}selected{% endif %}>{{ 'reports.preset.thisWeek'|t('best-sellers') }}</option>
				<option value="thisMonth" {% if preset == 'thisMonth' %}selected{% endif %}>{{ 'reports.preset.thisMonth'|t('best-sellers') }}</option>
				<option value="thisYear" {% if preset == 'thisYear' %}selected{% endif %}>{{ 'reports.preset.thisYear'|t('best-sellers') }}</option>
				<option value="past7Days" {% if preset == 'past7Days' %}selected{% endif %}>{{ 'reports.preset.past7Days'|t('best-sellers') }}</option>
				<option value="past30Days" {% if preset == 'past30Days' %}selected{% endif %}>{{ 'reports.preset.past30Days'|t('best-sellers') }}</option>
				<option value="past90Days" {% if preset == 'past90Days' %}selected{% endif %}>{{ 'reports.preset.past90Days'|t('best-sellers') }}</option>
				<option value="pastYear" {% if preset == 'pastYear' %}selected{% endif %}>{{ 'reports.preset.pastYear'|t('best-sellers') }}</option>
			</select>
		</div>

		<input type="hidden" id="preset" name="preset" value="{{ preset|default('') }}">

		<div style="flex: 1;">
			<input type="text" id="from" name="from" value="{{ from }}" placeholder="{{ 'From'|t('app') }}" class="text fullwidth">
		</div>

		<div style="flex: 1;">
			<input type="text" id="to" name="to" value="{{ to }}" placeholder="{{ 'To'|t('app') }}" class="text fullwidth">
		</div>

		<div style="align-self: flex-end;">
			{{ forms.submitButton({
				label: 'Update'|t('app')
			}) }}
		</div>
	</form>
{% endset %}

{% set products = craft.commerce.products %}

{% css %}
	{% include 'best-sellers/_includes/plugin-footer-css' %}
{% endcss %}

{% set content %}
	<main class="main-content">
	<h2>{{ 'widgets.bestSellers.title'|t('best-sellers') }}</h2>
	<br>
	{% if items is empty %}
		<p>{{ 'dashboard.noBestSellers'|t('best-sellers') }}</p>
	{% else %}
		<div class="main tablepane">
			<table id="items" class="data fullwidth">
				<thead>
				{% if productsOrVariants == 'variants' %}
					<th scope="col">{{ 'dashboard.col.variant'|t('best-sellers') }}</th>
					<th scope="col">{{ 'SKU'|t('commerce') }}</th>
					<th scope="col">{{ 'dashboard.col.totalSold'|t('best-sellers') }}</th>
				{% else %}
					<th scope="col">{{ 'products.col.product'|t('best-sellers') }}</th>
					<th scope="col">{{ 'products.col.defaultSku'|t('best-sellers') }}</th>
					<th scope="col">{{ 'Type'|t('app') }}</th>
					<th scope="col">{{ 'dashboard.col.totalSold'|t('best-sellers') }}</th>
				{% endif %}
				</thead>
				<tbody>
				{% for item in items %}
					<tr tabindex="0">
						<td data-title="{{ 'dashboard.col.title'|t('best-sellers') }}">
							{% set shownTitle = item.title|length > 100 ? item.title|slice(0, 100) ~ '…' : item.title %}
							<span><a class="go" href="{{ item.url }}" title="{{ item.title }}">{{ shownTitle }}</a></span>
						</td>
						<td data-title="{{ 'Type'|t('app') }}">
							{{ item.sku }}
						</td>
						{% if productsOrVariants == 'products' %}
						<td data-title="{{ 'Type'|t('app') }}">
							{{ item.type }}
						</td>
						{% endif %}
						<td data-title="{{ 'Type'|t('app') }}">
							{{ item.totalQtySold }}
						</td>
					</tr>
				{% endfor %}
				</tbody>
			</table>
		</div>

		<div id="footer" class="flex">
			<div id="count-container" class="light flex-grow">
				{% include '_includes/pagination' with {
					'pageInfo' : pagination,
					'itemLabel' : 'dashboard.itemLabel'|t('best-sellers'),
					'itemsLabel': 'dashboard.itemsLabel'|t('best-sellers')
				} %}
			</div>
		</div>
	{% endif %}
	</main>
	{% include 'best-sellers/_includes/plugin-footer' %}
{% endset %}

{% js %}
	document.getElementById('product-type').addEventListener('change', function() {
	document.getElementById('filter-form').submit();
	});

	document.getElementById('products-or-variants').addEventListener('change', function() {
	document.getElementById('filter-form').submit();
	});

	document.addEventListener('DOMContentLoaded', function() {
	const presetSelector = document.getElementById('date-presets');
	const fromInput = document.getElementById('from');
	const toInput = document.getElementById('to');
	const presetHidden = document.getElementById('preset');

	presetSelector.addEventListener('change', function() {
	const preset = this.value;
	const now = new Date();
	let fromVal = '';
	let toVal = '';

	switch(preset) {
	case 'today':
	fromVal = toVal = now.toISOString().split('T')[0];
	break;
	case 'thisWeek': {
	const day = now.getDay() || 7; // treat Sunday as 7
	const monday = new Date(now);
	monday.setDate(now.getDate() - day + 1);
	const sunday = new Date(now);
	sunday.setDate(now.getDate() + (7 - day));
	fromVal = monday.toISOString().split('T')[0];
	toVal = sunday.toISOString().split('T')[0];
	break;
	}
	case 'thisMonth': {
	const firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
	const lastDay = new Date(now.getFullYear(), now.getMonth() + 1, 0);
	fromVal = firstDay.toISOString().split('T')[0];
	toVal = lastDay.toISOString().split('T')[0];
	break;
	}
	case 'thisYear': {
	const firstDay = new Date(now.getFullYear(), 0, 1);
	const lastDay = new Date(now.getFullYear(), 11, 31);
	fromVal = firstDay.toISOString().split('T')[0];
	toVal = lastDay.toISOString().split('T')[0];
	break;
	}
	case 'past7Days': {
	const past = new Date(now);
	past.setDate(now.getDate() - 7);
	fromVal = past.toISOString().split('T')[0];
	toVal = now.toISOString().split('T')[0];
	break;
	}
	case 'past30Days': {
	const past = new Date(now);
	past.setDate(now.getDate() - 30);
	fromVal = past.toISOString().split('T')[0];
	toVal = now.toISOString().split('T')[0];
	break;
	}
	case 'past90Days': {
	const past = new Date(now);
	past.setDate(now.getDate() - 90);
	fromVal = past.toISOString().split('T')[0];
	toVal = now.toISOString().split('T')[0];
	break;
	}
	case 'pastYear': {
	const past = new Date(now);
	past.setFullYear(now.getFullYear() - 1);
	fromVal = past.toISOString().split('T')[0];
	toVal = now.toISOString().split('T')[0];
	break;
	}
	default:
	fromVal = fromInput.value;
	toVal = toInput.value;
	}
	fromInput.value = fromVal;
	toInput.value = toVal;
	presetHidden.value = preset;
	});
	});
{% endjs %}
