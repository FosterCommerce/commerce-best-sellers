{#
 # KPI Card macro
 #
 # Usage:
 #   {% import 'best-sellers/_includes/kpi-card' as kpi %}
 #   {{ kpi.card({ label: 'Revenue'|t('commerce'), value: '$1,234', change: 12.5, sparklineId: 'sparkRevenue' }) }}
 #
 # The caller is responsible for translating `label` and `description` before
 # passing them in. KpiCards::definitions() does this for built-in cards.
 #}

{% macro card(params) %}
	{% set label = params.label ?? '' %}
	{% set value = params.value ?? '---' %}
	{% set change = params.change ?? null %}
	{% set sparklineId = params.sparklineId ?? null %}
	{% set format = params.format ?? 'text' %}
	{% set description = params.description ?? null %}
	{% set changeFormat = params.changeFormat ?? 'percent' %}
	{% set url = params.url ?? null %}

	<div class="bs-kpi-card">
		<div class="bs-kpi-card__header">
			<p class="bs-kpi-card__label">
				{% if url %}
					<a href="{{ url }}">{{ label }}</a>
				{% else %}
					{{ label }}
				{% endif %}
			</p>
			{% if change is not null %}
				{% set changeText = changeFormat == 'points'
					? 'kpi.changePoints'|t('best-sellers', { value: change|abs|number_format(1) })
					: change|abs|number_format(2) ~ '%' %}
				{% if change > 0 %}
					<span class="bs-kpi-card__change bs-kpi-card__change--up">&#9650; {{ changeText }}</span>
				{% elseif change < 0 %}
					<span class="bs-kpi-card__change bs-kpi-card__change--down">&#9660; {{ changeText }}</span>
				{% else %}
					<span class="bs-kpi-card__change bs-kpi-card__change--neutral">{{ changeFormat == 'points' ? 'kpi.noChangePoints'|t('best-sellers') : '0%' }}</span>
				{% endif %}
			{% endif %}
		</div>
		<p class="bs-kpi-card__value">
			{% if format == 'currency' %}
				{{ value|commerceCurrency }}
			{% elseif format == 'percent' %}
				{{ value|number_format(1) }}%
			{% elseif format == 'decimal' %}
				{{ value|number_format(2) }}
			{% elseif format == 'number' %}
				{{ value|number_format }}
			{% else %}
				{{ value }}
			{% endif %}
		</p>
		{% if description %}
			<p style="margin: 0.5rem 0 0; font-size: 0.8rem; color: #999;">{{ description }}</p>
		{% endif %}
		{% if sparklineId %}
			<canvas id="{{ sparklineId }}" class="bs-kpi-card__sparkline"></canvas>
		{% endif %}
	</div>
{% endmacro %}
