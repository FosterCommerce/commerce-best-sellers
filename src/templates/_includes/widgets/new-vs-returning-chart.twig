{# New vs Returning Customers Chart #}
<div class="bs-chart-container">
	<h3 class="bs-chart-container__title">{{ 'widgets.newVsReturning.title'|t('best-sellers') }}</h3>
	{% if newVsReturning.labels|length > 0 %}
		<div style="position: relative; height: 300px;">
			<canvas id="newVsReturningChart"></canvas>
		</div>
	{% else %}
		<p>{{ 'table.noData'|t('best-sellers') }}</p>
	{% endif %}
</div>
