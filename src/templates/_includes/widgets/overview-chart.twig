{# Revenue / Orders / AOV Toggle Chart #}
<div class="bs-chart-container">
	<div class="bs-segmented">
		<button type="button" class="bs-segmented__btn bs-segmented__btn--active" data-chart="revenue">{{ 'Revenue'|t('commerce') }}</button>
		<button type="button" class="bs-segmented__btn" data-chart="orders">{{ 'Orders'|t('commerce') }}</button>
		<button type="button" class="bs-segmented__btn" data-chart="aov">{{ 'kpi.aov'|t('best-sellers') }}</button>
	</div>
	<div style="position: relative; height: 350px;">
		<canvas id="overviewChart"></canvas>
	</div>
</div>
