{% extends '_layouts/cp' %}
{% do view.registerTranslations('best-sellers', [
	'pagination.showingRange',
	'pagination.previous',
	'pagination.next',
	'pagination.pageOf',
	'pagination.exportCsv',
	'errors.loadData',
	'chip.filtered',
	'chip.clearFilter',
	'sales.urlFilter.shipping',
	'sales.urlFilter.discountedOrders',
	'sales.urlFilter.fullPriceOrders',
	'sales.urlFilter.discountId',
	'sales.urlFilter.itemsPerOrder',
	'loading.phrase.archives',
	'loading.phrase.elfBoxes',
	'loading.phrase.ledger',
	'loading.phrase.gnome',
	'loading.phrase.spreadsheets',
	'loading.phrase.elfReceipts',
	'loading.phrase.elfSpeed',
	'loading.phrase.vault',
	'loading.phrase.fairy',
	'loading.phrase.packingSlips',
]) %}

{% set selectedSubnavItem = selectedSubnavItem ?? 'overview' %}

{% set additionalButtons %}
	{% include 'best-sellers/_includes/date-picker' with {
		from: from,
		to: to,
		preset: preset,
		scope: scope ?? null,
	} only %}
{% endset %}

{% css %}
	{% include 'best-sellers/_includes/plugin-footer-css' %}
{% endcss %}

{% set content %}
	<div class="bs-reports-container">
		{% block reportContent %}{% endblock %}
	</div>
	{% include 'best-sellers/_includes/plugin-footer' %}
{% endset %}
