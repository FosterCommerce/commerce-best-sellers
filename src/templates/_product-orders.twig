{% extends 'best-sellers/_layouts/reports' %}

{% set title = 'productOrders.titleSuffix'|t('best-sellers', { title: itemTitle }) %}
{% set selectedSubnavItem = 'products' %}

{% block reportContent %}
	<p style="margin-bottom: 1.5rem;">
		<a href="#" onclick="history.back(); return false;">
			&larr; {{ 'productOrders.back'|t('best-sellers') }}
		</a>
	</p>

	{# Loading State #}
	<div id="product-orders-loading" class="bs-loading">
		<div class="bs-loading__spinner"></div>
		<p class="bs-loading__message">{{ 'productOrders.loading'|t('best-sellers') }}</p>
	</div>

	<div id="product-orders-container" class="hidden">
		<div style="overflow-x: auto;">
			<table class="bs-data-table">
				<thead>
					<tr>
						<th data-sort="reference">{{ 'Order'|t('commerce') }}</th>
						<th data-sort="dateOrdered">{{ 'Date'|t('app') }}</th>
						<th data-sort="email">{{ 'Customer'|t('commerce') }}</th>
						<th class="bs-data-table--right" data-sort="qty">{{ 'Qty'|t('commerce') }}</th>
						<th class="bs-data-table--right" data-sort="lineRevenue">{{ 'productOrders.col.lineRevenue'|t('best-sellers') }}</th>
						<th class="bs-data-table--right" data-sort="orderTotal">{{ 'productOrders.col.orderTotal'|t('best-sellers') }}</th>
					</tr>
				</thead>
				<tbody id="product-orders-tbody"></tbody>
			</table>
		</div>
		<div id="product-orders-pagination" class="bs-pagination"></div>
	</div>
{% endblock %}

{% js %}
document.addEventListener('DOMContentLoaded', function () {
	const table = BestSellersReports.createAjaxTable({
		loadingEl: document.getElementById('product-orders-loading'),
		containerEl: document.getElementById('product-orders-container'),
		tbodyEl: document.getElementById('product-orders-tbody'),
		paginationEl: document.getElementById('product-orders-pagination'),
		actionUrl: 'best-sellers/products/product-orders-data',
		defaultSort: 'dateOrdered',
		defaultSortDir: 'desc',
		baseParams: {
			from: '{{ from }}',
			to: '{{ to }}',
			preset: '{{ preset }}',
			productId: '{{ productId }}',
			variantId: '{{ variantId }}'
		},
		itemLabel: 'orders',
		emptyMessage: '{{ "productOrders.empty"|t("best-sellers") }}',
		buildRow: function (order) {
			const row = document.createElement('tr');
			row.innerHTML =
				'<td><a href="' + order.cpEditUrl + '" class="go">' + order.reference + '</a></td>' +
				'<td>' + order.dateOrdered + '</td>' +
				'<td>' + order.email + '</td>' +
				'<td class="bs-data-table--right">' + order.qty + '</td>' +
				'<td class="bs-data-table--right">' + order.lineRevenue + '</td>' +
				'<td class="bs-data-table--right">' + order.orderTotal + '</td>';
			return row;
		}
	});

	table.init();
});
{% endjs %}
