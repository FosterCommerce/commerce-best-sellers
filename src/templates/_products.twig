{% extends 'best-sellers/_layouts/reports' %}

{% set title = "Products"|t('best-sellers') %}
{% set selectedSubnavItem = 'products' %}

{% block reportContent %}
	{# Filters #}
	<div class="bs-filter-bar bs-filter-bar--spaced">
		<div class="bs-filter-bar__item bs-filter-bar__item--shrink">
			<input type="hidden" id="products-or-variants" value="{{ productsOrVariants }}">
			<div class="bs-segmented bs-pov-toggle" role="group" aria-label="{{ 'Show products or variants'|t('best-sellers') }}">
				<button type="button" class="bs-segmented__btn{{ productsOrVariants == 'products' ? ' bs-segmented__btn--active' : '' }}" data-value="products" aria-pressed="{{ productsOrVariants == 'products' ? 'true' : 'false' }}">{{ "Products"|t('best-sellers') }}</button>
				<button type="button" class="bs-segmented__btn{{ productsOrVariants == 'variants' ? ' bs-segmented__btn--active' : '' }}" data-value="variants" aria-pressed="{{ productsOrVariants == 'variants' ? 'true' : 'false' }}">{{ "Variants"|t('best-sellers') }}</button>
			</div>
		</div>
		{% set allProductTypes = craft.commerce.productTypes.allProductTypes %}
		{% if allProductTypes|length > 1 %}
			<div class="bs-multiselect" id="product-type-multiselect">
				<button type="button" class="bs-multiselect__btn" data-label="{{ 'Product Type'|t('best-sellers') }}">{{ "Product Type"|t('best-sellers') }}</button>
				<div class="bs-multiselect__dropdown">
					{% for type in allProductTypes %}
						<label><input type="checkbox" value="{{ type.handle }}"{% if type.handle in selectedProductTypes %} checked{% endif %}> {{ type.name }}</label>
					{% endfor %}
				</div>
			</div>
		{% endif %}
		<div class="bs-filter-bar__item">
			<input type="text" id="product-search" class="text fullwidth" placeholder="{{ 'Search...'|t('best-sellers') }}" autocomplete="off">
		</div>
		<span id="products-export"></span>
	</div>

	{# Loading State #}
	<div id="products-loading" class="bs-loading">
		<div class="bs-loading__spinner"></div>
		<p class="bs-loading__message">{{ "Fetching your data from the vault..."|t('best-sellers') }}</p>
	</div>

	{# Products Table (hidden until loaded) #}
	<div id="products-container" class="hidden">
		<div id="products-totals" class="bs-totals-bar" hidden></div>
		<div style="overflow-x: auto;">
			<table class="bs-data-table" id="products-table">
				<thead>
					<tr>
						<th data-sort="productTitle">{{ "Product"|t('best-sellers') }}</th>
						<th data-sort="sku">{{ "Default SKU"|t('best-sellers') }}</th>
						<th data-sort="productType">{{ "Type"|t('best-sellers') }}</th>
						<th class="bs-data-table--right" data-sort="unitsSold">{{ "Units Sold"|t('best-sellers') }}</th>
						<th class="bs-data-table--right" data-sort="itemSubtotal">{{ "Item Subtotal"|t('best-sellers') }}</th>
						<th class="bs-data-table--right" data-sort="revenue">{{ "Item Sales (Net)"|t('best-sellers') }}</th>
						<th class="bs-data-table--right" data-sort="avgPrice">{{ "Avg Price"|t('best-sellers') }}</th>
						<th style="width: 32px; text-align: center;"><span data-icon="world" aria-label="{{ 'Link'|t('best-sellers') }}"></span></th>
					</tr>
				</thead>
				<tbody id="products-tbody"></tbody>
			</table>
		</div>
		<div id="products-pagination" class="bs-pagination"></div>

		<details class="bs-data-notes">
			<summary>{{ "About these numbers"|t('best-sellers') }}</summary>
			<ul>
				<li>{{ "{label} is quantity × sale price across the contributing line items. Sale-price promotions are already baked in; coupon and manual discounts are not subtracted here, so this column reconciles with the Orders report's {ordersLabel} column when summed across the same orders."|t('best-sellers', { label: '<strong>' ~ 'Item Subtotal'|t('best-sellers') ~ '</strong>', ordersLabel: '<strong>' ~ 'Item Subtotal'|t('best-sellers') ~ '</strong>' })|raw }}</li>
				<li>{{ "{label} is {subtotalLabel} minus any coupon or manual discounts attributed to the line."|t('best-sellers', { label: '<strong>' ~ 'Item Sales (Net)'|t('best-sellers') ~ '</strong>', subtotalLabel: '<strong>' ~ 'Item Subtotal'|t('best-sellers') ~ '</strong>' })|raw }}</li>
				<li>{{ "Coupon and manual discounts are netted out, including order-level discounts (Commerce always attaches Discount adjustments to specific line items, even when the rule is configured order-wide)."|t('best-sellers') }}</li>
				<li>{{ "Tax and shipping are not included."|t('best-sellers') }}</li>
				<li>{{ "Refunds: fully refunded orders are dropped via the full-balance-owed exclusion. Partial refunds still count the full original sale amount for the line; the refund is not netted against the row."|t('best-sellers') }}</li>
				<li>{{ "Orders with a full balance owed (totalPaid ≤ 0 AND totalPrice > 0) are excluded. This drops orders that were authorized but never captured, were fully refunded, or had a failed payment; completion is not the same as money received. Partially paid orders are still counted, and a ⚠ next to a row’s units count means at least one of that row’s orders is currently partially paid. For actual money received, use the Orders report’s Total Paid column."|t('best-sellers') }}</li>
				<li>{{ "Bundle sales (subtotals and discounts both) are distributed proportionally across the constituent variants, not the bundle itself."|t('best-sellers') }}</li>
				<li>{{ "Sales numbers re-sync automatically when an order is saved (initial completion, admin edits, status changes, etc.). The ⚠ partial-payment marker is live and reflects current payment state."|t('best-sellers') }}</li>
				<li>{{ "{label} averages the line-item list price (pre-promotion), so it does not divide cleanly into {revLabel}."|t('best-sellers', { label: '<strong>' ~ 'Avg Price'|t('best-sellers') ~ '</strong>', revLabel: '<strong>' ~ 'Item Sales (Net)'|t('best-sellers') ~ '</strong>' })|raw }}</li>
			</ul>
		</details>
	</div>
{% endblock %}

{% js %}
document.addEventListener('DOMContentLoaded', function () {
	const searchInput = document.getElementById('product-search');
	const povInput = document.getElementById('products-or-variants');
	const povButtons = document.querySelectorAll('.bs-pov-toggle .bs-segmented__btn');
	const productTypeContainer = document.getElementById('product-type-multiselect');
	let searchTimer = null;

	function setPovValue(value) {
		povInput.value = value;
		povButtons.forEach(function (button) {
			const isActive = button.dataset.value === value;
			button.classList.toggle('bs-segmented__btn--active', isActive);
			button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
		});
	}

	const productTypeMulti = productTypeContainer ? BestSellersReports.createMultiSelect({
		container: productTypeContainer,
		onChange: function () { table.reload(); }
	}) : null;

	const table = BestSellersReports.createAjaxTable({
		loadingEl: document.getElementById('products-loading'),
		containerEl: document.getElementById('products-container'),
		tbodyEl: document.getElementById('products-tbody'),
		paginationEl: document.getElementById('products-pagination'),
		totalsEl: document.getElementById('products-totals'),
		actionUrl: 'best-sellers/products/products-data',
		exportUrl: 'best-sellers/products/export-csv',
		exportContainerEl: document.getElementById('products-export'),
		baseParams: { from: '{{ from }}', to: '{{ to }}', preset: '{{ preset }}' },
		defaultSort: 'revenue',
		defaultSortDir: 'desc',
		itemLabel: 'products',
		emptyMessage: 'No product sales data for this period.',
		buildRow: function (item) {
			const row = document.createElement('tr');
			const fullTitle = item.displayTitle || '';
			const shownTitle = BestSellersReports.truncate(fullTitle, 100);
			const titleAttr = ' title="' + BestSellersReports.escapeAttr(fullTitle) + '"';
			let titleCell = item.cpEditUrl
				? '<a href="' + item.cpEditUrl + '" class="go"' + titleAttr + '>' + shownTitle + '</a>'
				: '<span' + titleAttr + '>' + shownTitle + '</span>';
			if (item.fromBundle) {
				titleCell += ' <span class="bs-bundle-marker" title="{{ "Sold as part of a bundle"|t('best-sellers') }}" aria-label="{{ "Sold as part of a bundle"|t('best-sellers') }}">⧉</span>';
			}
			const linkCell = item.frontEndUrl
				? '<a href="' + item.frontEndUrl + '" target="_blank" rel="noopener" class="bs-external-link"><span data-icon="world"></span></a>'
				: '';
			const ordersLink = '<a href="' + item.ordersUrl + '" class="light" style="text-decoration:underline">in ' + item.orderCount + ' orders</a>';

			const unpaidMarker = item.hasUnpaidOrder
				? '<span class="bs-unpaid-marker" title="{{ "At least one contributing order is not fully paid"|t('best-sellers') }}" aria-label="{{ "At least one contributing order is not fully paid"|t('best-sellers') }}">⚠</span> '
				: '';
			row.innerHTML =
				'<td>' + titleCell + '</td>' +
				'<td>' + item.sku + '</td>' +
				'<td>' + item.productType + '</td>' +
				'<td class="bs-data-table--right">' + unpaidMarker + item.unitsSold + ' ' + ordersLink + '</td>' +
				'<td class="bs-data-table--right">' + item.itemSubtotal + '</td>' +
				'<td class="bs-data-table--right">' + item.revenue + '</td>' +
				'<td class="bs-data-table--right">' + item.avgPrice + '</td>' +
				'<td style="text-align:center">' + linkCell + '</td>';
			return row;
		},
		buildTotalsBar: function (totals) {
			return BestSellersReports.buildTotalsBar(
				'{{ "Filtered Results Total"|t("best-sellers") }}',
				[
					{ label: '{{ "Units Sold"|t("best-sellers") }}', value: totals.unitsSold },
					{ label: '{{ "Item Subtotal"|t("best-sellers") }}', value: totals.itemSubtotal },
					{ label: '{{ "Item Sales (Net)"|t("best-sellers") }}', value: totals.revenue }
				]
			);
		},
		getFilterParams: function () {
			const params = {};
			params.productsOrVariants = povInput.value;
			if (productTypeMulti) {
				const productTypes = productTypeMulti.getSelected();
				if (productTypes.length > 0) { params['productType[]'] = productTypes; }
			}
			const searchValue = searchInput.value.trim();
			if (searchValue) { params.search = searchValue; }
			return params;
		},
		restoreFilterState: function (filters) {
			if (filters.search) { searchInput.value = filters.search; }
			if (filters.productsOrVariants) { setPovValue(filters.productsOrVariants); }
			if (filters['productType[]'] && productTypeMulti) {
				const typeValues = filters['productType[]'];
				productTypeContainer.querySelectorAll('input[type="checkbox"]').forEach(function (checkbox) {
					checkbox.checked = typeValues.indexOf(checkbox.value) !== -1;
				});
				productTypeMulti.refresh();
			}
		}
	});

	function reloadTable() { table.reload(); }

	searchInput.addEventListener('input', function () {
		clearTimeout(searchTimer);
		searchTimer = setTimeout(reloadTable, 400);
	});

	povButtons.forEach(function (button) {
		button.addEventListener('click', function () {
			setPovValue(button.dataset.value);
			reloadTable();
		});
	});

	table.init();
});
{% endjs %}
