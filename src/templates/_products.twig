{% extends 'best-sellers/_layouts/reports' %}
{% do view.registerTranslations('best-sellers', [
	'products.inOrders',
]) %}

{% set title = 'Products'|t('commerce') %}
{% set selectedSubnavItem = 'products' %}

{% block reportContent %}
	{# Filters #}
	<div class="bs-filter-bar bs-filter-bar--spaced">
		{% set allProductTypes = craft.commerce.productTypes.allProductTypes %}
		{% if allProductTypes|length > 1 %}
			<div class="bs-multiselect" id="product-type-multiselect">
				<button type="button" class="bs-multiselect__btn" data-label="{{ 'Product Type'|t('commerce') }}">{{ 'Product Type'|t('commerce') }}</button>
				<div class="bs-multiselect__dropdown">
					{% for type in allProductTypes %}
						<label><input type="checkbox" value="{{ type.handle }}"{% if type.handle in selectedProductTypes %} checked{% endif %}> {{ type.name }}</label>
					{% endfor %}
				</div>
			</div>
		{% endif %}
		<div class="bs-filter-bar__item bs-filter-bar__item--shrink">
			<input type="hidden" id="products-or-variants" value="{{ productsOrVariants }}">
			<div class="bs-segmented bs-pov-toggle" role="group" aria-label="{{ 'products.filter.showProductsOrVariants'|t('best-sellers') }}">
				<button type="button" class="bs-segmented__btn{{ productsOrVariants == 'products' ? ' bs-segmented__btn--active' : '' }}" data-value="products" aria-pressed="{{ productsOrVariants == 'products' ? 'true' : 'false' }}">{{ 'Products'|t('commerce') }}</button>
				<button type="button" class="bs-segmented__btn{{ productsOrVariants == 'variants' ? ' bs-segmented__btn--active' : '' }}" data-value="variants" aria-pressed="{{ productsOrVariants == 'variants' ? 'true' : 'false' }}">{{ 'Variants'|t('commerce') }}</button>
			</div>
		</div>
		{% if showProfitToggle %}
			<div class="bs-filter-bar__item bs-filter-bar__item--shrink">
				<input type="hidden" id="report-mode" value="{{ reportMode }}">
				<div class="bs-segmented bs-report-mode-toggle" role="group" aria-label="{{ 'products.filter.showSalesOrProfit'|t('best-sellers') }}">
					<button type="button" class="bs-segmented__btn{{ reportMode == 'sales' ? ' bs-segmented__btn--active' : '' }}" data-value="sales" aria-pressed="{{ reportMode == 'sales' ? 'true' : 'false' }}">{{ 'products.filter.allSales'|t('best-sellers') }}</button>
					<button type="button" class="bs-segmented__btn{{ reportMode == 'profit' ? ' bs-segmented__btn--active' : '' }}" data-value="profit" aria-pressed="{{ reportMode == 'profit' ? 'true' : 'false' }}">{{ 'products.filter.profit'|t('best-sellers') }}</button>
				</div>
			</div>
		{% endif %}
		{% for fieldFilterGroup in fieldFilterGroups %}
			{% set isActiveGroup = fieldFilterGroup.productTypeHandle == activeProductTypeHandle %}
			{% for fieldFilter in fieldFilterGroup.filters %}
				<div class="bs-multiselect bs-field-filter{{ isActiveGroup ? '' : ' hidden' }}" data-product-type="{{ fieldFilterGroup.productTypeHandle }}" data-instance="{{ fieldFilter.instanceUid }}">
					<button type="button" class="bs-multiselect__btn" data-label="{{ fieldFilter.label }}">{{ fieldFilter.label }}</button>
					<div class="bs-multiselect__dropdown">
						{% set selectedValues = isActiveGroup ? (selectedFilterValues[fieldFilter.instanceUid] ?? []) : [] %}
						{% for optionValue, optionLabel in fieldFilter.options %}
							<label><input type="checkbox" value="{{ optionValue }}"{% if optionValue ~ '' in selectedValues %} checked{% endif %}> {{ optionLabel }}</label>
						{% endfor %}
					</div>
				</div>
			{% endfor %}
		{% endfor %}
		<div class="bs-filter-bar__item">
			<input type="text" id="product-search" class="text fullwidth" placeholder="{{ 'products.filter.searchPlaceholder'|t('best-sellers') }}" autocomplete="off">
		</div>
		<span id="products-export"></span>
	</div>

	{# Loading State #}
	<div id="products-loading" class="bs-loading">
		<div class="bs-loading__spinner"></div>
		<p class="bs-loading__message">{{ 'products.loading'|t('best-sellers') }}</p>
	</div>

	{# Products Table (hidden until loaded) #}
	<div id="products-container" class="hidden">
		<div id="products-totals" class="bs-totals-bar" hidden></div>
		<div style="overflow-x: auto;">
			<table class="bs-data-table" id="products-table">
				<thead>
					<tr>
						<th data-sort="productTitle">{{ 'products.col.product'|t('best-sellers') }}</th>
						<th data-sort="sku">{{ 'products.col.defaultSku'|t('best-sellers') }}</th>
						<th data-sort="productType">{{ 'Type'|t('app') }}</th>
						<th class="bs-data-table--right" data-sort="unitsSold">{{ 'products.col.unitsSold'|t('best-sellers') }}</th>
						<th class="bs-data-table--right" data-sort="itemSubtotal">{{ 'Item Subtotal'|t('commerce') }}</th>
						<th class="bs-data-table--right" data-sort="revenue">{{ 'products.col.itemSalesNet'|t('best-sellers') }}</th>
						<th class="bs-data-table--right" data-sort="avgPrice">{{ 'products.col.avgPrice'|t('best-sellers') }}</th>
						{% if showProfitToggle %}
							{% set profitColumnClass = 'bs-data-table--right bs-profit-col' ~ (reportMode == 'profit' ? '' : ' hidden') %}
							<th class="{{ profitColumnClass }}" data-sort="cost">{{ 'products.col.cost'|t('best-sellers') }}</th>
							<th class="{{ profitColumnClass }}" data-sort="grossProfit">{{ 'products.col.grossProfit'|t('best-sellers') }}</th>
							<th class="{{ profitColumnClass }}" data-sort="grossMargin">{{ 'products.col.grossMargin'|t('best-sellers') }}</th>
						{% endif %}
						<th style="width: 32px; text-align: center;"><span data-icon="world" aria-label="{{ 'products.col.linkAria'|t('best-sellers') }}"></span></th>
					</tr>
				</thead>
				<tbody id="products-tbody"></tbody>
			</table>
		</div>
		<div id="products-pagination" class="bs-pagination"></div>

		<details class="bs-data-notes">
			<summary>{{ 'table.aboutTheseNumbers'|t('best-sellers') }}</summary>
			<ul>
				<li>{{ 'products.notes.itemSubtotal'|t('best-sellers', { label: '<strong>' ~ 'Item Subtotal'|t('commerce') ~ '</strong>', ordersLabel: '<strong>' ~ 'Item Subtotal'|t('commerce') ~ '</strong>' })|raw }}</li>
				<li>{{ 'products.notes.itemSalesNet'|t('best-sellers', { label: '<strong>' ~ 'products.col.itemSalesNet'|t('best-sellers') ~ '</strong>', subtotalLabel: '<strong>' ~ 'Item Subtotal'|t('commerce') ~ '</strong>' })|raw }}</li>
				<li>{{ 'products.notes.discountsNetted'|t('best-sellers') }}</li>
				<li>{{ 'products.notes.taxShipping'|t('best-sellers') }}</li>
				<li>{{ 'products.notes.refunds'|t('best-sellers') }}</li>
				<li>{{ 'products.notes.fullBalanceOwed'|t('best-sellers') }}</li>
				<li>{{ 'products.notes.bundles'|t('best-sellers') }}</li>
				<li>{{ 'products.notes.resync'|t('best-sellers') }}</li>
				{% if showProfitToggle %}
					<li>{{ 'products.notes.cost'|t('best-sellers') }}</li>
				{% endif %}
				<li>{{ 'products.notes.avgPrice'|t('best-sellers', { label: '<strong>' ~ 'products.col.avgPrice'|t('best-sellers') ~ '</strong>', revLabel: '<strong>' ~ 'products.col.itemSalesNet'|t('best-sellers') ~ '</strong>' })|raw }}</li>
			</ul>
		</details>
	</div>
{% endblock %}

{% js %}
document.addEventListener('DOMContentLoaded', function () {
	const searchInput = document.getElementById('product-search');
	const povInput = document.getElementById('products-or-variants');
	const povButtons = document.querySelectorAll('.bs-pov-toggle .bs-segmented__btn');
	const productTypeContainer = document.getElementById('product-type-multiselect');
	const onlyProductTypeHandle = {{ onlyProductTypeHandle|json_encode|raw }};
	// A productType parameter in the URL replaces the saved product type and field filters
	const hasUrlProductType = new URLSearchParams(window.location.search).has('productType');
	const reportModeInput = document.getElementById('report-mode');
	const reportModeButtons = document.querySelectorAll('.bs-report-mode-toggle .bs-segmented__btn');

	function isProfitView() {
		return reportModeInput !== null && reportModeInput.value === 'profit';
	}

	function setReportMode(value) {
		reportModeInput.value = value;
		reportModeButtons.forEach(function (button) {
			const isActive = button.dataset.value === value;
			button.classList.toggle('bs-segmented__btn--active', isActive);
			button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
		});
		document.querySelectorAll('.bs-profit-col').forEach(function (header) {
			header.classList.toggle('hidden', value !== 'profit');
		});
	}
	let searchTimer = null;

	function setPovValue(value) {
		povInput.value = value;
		povButtons.forEach(function (button) {
			const isActive = button.dataset.value === value;
			button.classList.toggle('bs-segmented__btn--active', isActive);
			button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
		});
	}

	const productTypeMulti = productTypeContainer ? BestSellersReports.createMultiSelect({
		container: productTypeContainer,
		onChange: function () {
			updateFieldFilterVisibility();
			table.reload();
		}
	}) : null;

	const fieldFilters = Array.from(document.querySelectorAll('.bs-field-filter')).map(function (container) {
		return {
			container: container,
			multi: BestSellersReports.createMultiSelect({
				container: container,
				onChange: function () { table.reload(); }
			})
		};
	});

	function getActiveProductType() {
		if (onlyProductTypeHandle) { return onlyProductTypeHandle; }
		const selectedProductTypes = productTypeMulti ? productTypeMulti.getSelected() : [];
		return selectedProductTypes.length === 1 ? selectedProductTypes[0] : null;
	}

	// Clear filters for product types outside the selection, since each filter belongs to one type
	function updateFieldFilterVisibility() {
		const activeProductType = getActiveProductType();
		fieldFilters.forEach(function (fieldFilter) {
			const isActive = fieldFilter.container.dataset.productType === activeProductType;
			fieldFilter.container.classList.toggle('hidden', !isActive);
			if (!isActive) {
				fieldFilter.container.querySelectorAll('input[type="checkbox"]').forEach(function (checkbox) { checkbox.checked = false; });
				fieldFilter.multi.refresh();
			}
		});
	}

	const table = BestSellersReports.createAjaxTable({
		loadingEl: document.getElementById('products-loading'),
		containerEl: document.getElementById('products-container'),
		tbodyEl: document.getElementById('products-tbody'),
		paginationEl: document.getElementById('products-pagination'),
		totalsEl: document.getElementById('products-totals'),
		actionUrl: 'best-sellers/products/products-data',
		exportUrl: 'best-sellers/products/export-csv',
		exportContainerEl: document.getElementById('products-export'),
		baseParams: { from: '{{ from }}', to: '{{ to }}', preset: '{{ preset }}' },
		defaultSort: 'revenue',
		defaultSortDir: 'desc',
		itemLabel: 'products',
		emptyMessage: '{{ "products.empty"|t("best-sellers") }}',
		buildRow: function (item) {
			const row = document.createElement('tr');
			const fullTitle = item.displayTitle || '';
			const shownTitle = BestSellersReports.truncate(fullTitle, 100);
			const titleAttr = ' title="' + BestSellersReports.escapeAttr(fullTitle) + '"';
			let titleCell = item.cpEditUrl
				? '<a href="' + item.cpEditUrl + '" class="go"' + titleAttr + '>' + shownTitle + '</a>'
				: '<span' + titleAttr + '>' + shownTitle + '</span>';
			if (item.fromBundle) {
				titleCell += ' <span class="bs-bundle-marker" title="{{ "products.bundleMarker"|t('best-sellers') }}" aria-label="{{ "products.bundleMarker"|t('best-sellers') }}">⧉</span>';
			}
			const linkCell = item.frontEndUrl
				? '<a href="' + item.frontEndUrl + '" target="_blank" rel="noopener" class="bs-external-link"><span data-icon="world"></span></a>'
				: '';
			const ordersLink = '<a href="' + item.ordersUrl + '" class="light" style="text-decoration:underline">' + Craft.t('best-sellers', 'products.inOrders', { count: item.orderCount }) + '</a>';

			const unpaidMarker = item.hasUnpaidOrder
				? '<span class="bs-unpaid-marker" title="{{ "products.unpaidMarker"|t('best-sellers') }}" aria-label="{{ "products.unpaidMarker"|t('best-sellers') }}">⚠</span> '
				: '';
			const costCells = isProfitView()
				? '<td class="bs-data-table--right">' + item.cost + '</td>' +
					'<td class="bs-data-table--right">' + item.grossProfit + '</td>' +
					'<td class="bs-data-table--right">' + item.grossMargin + '</td>'
				: '';
			row.innerHTML =
				'<td>' + titleCell + '</td>' +
				'<td>' + item.sku + '</td>' +
				'<td>' + item.productType + '</td>' +
				'<td class="bs-data-table--right">' + unpaidMarker + item.unitsSold + ' ' + ordersLink + '</td>' +
				'<td class="bs-data-table--right">' + item.itemSubtotal + '</td>' +
				'<td class="bs-data-table--right">' + item.revenue + '</td>' +
				'<td class="bs-data-table--right">' + item.avgPrice + '</td>' +
				costCells +
				'<td style="text-align:center">' + linkCell + '</td>';
			return row;
		},
		buildTotalsBar: function (totals) {
			const totalsItems = [
				{ label: '{{ "products.col.unitsSold"|t("best-sellers") }}', value: totals.unitsSold },
				{ label: '{{ "Item Subtotal"|t("commerce") }}', value: totals.itemSubtotal },
				{ label: '{{ "products.col.itemSalesNet"|t("best-sellers") }}', value: totals.revenue }
			];
			if (isProfitView()) {
				totalsItems.push(
					{ label: '{{ "products.col.cost"|t("best-sellers") }}', value: totals.cost },
					{ label: '{{ "products.col.grossProfit"|t("best-sellers") }}', value: totals.grossProfit },
					{ label: '{{ "products.col.grossMargin"|t("best-sellers") }}', value: totals.grossMargin }
				);
			}
			return BestSellersReports.buildTotalsBar('{{ "table.filteredResultsTotal"|t("best-sellers") }}', totalsItems);
		},
		getFilterParams: function () {
			const params = {};
			params.productsOrVariants = povInput.value;
			if (isProfitView()) { params.reportMode = 'profit'; }
			if (productTypeMulti) {
				const productTypes = productTypeMulti.getSelected();
				if (productTypes.length > 0) { params['productType[]'] = productTypes; }
			}
			fieldFilters.forEach(function (fieldFilter) {
				const filterValues = fieldFilter.multi.getSelected();
				if (filterValues.length > 0) { params['fieldFilter[' + fieldFilter.container.dataset.instance + '][]'] = filterValues; }
			});
			const searchValue = searchInput.value.trim();
			if (searchValue) { params.search = searchValue; }
			return params;
		},
		restoreFilterState: function (filters) {
			if (filters.search) { searchInput.value = filters.search; }
			if (filters.productsOrVariants) { setPovValue(filters.productsOrVariants); }
			if (filters.reportMode && reportModeInput) { setReportMode(filters.reportMode); }
			if (filters['productType[]'] && productTypeMulti && !hasUrlProductType) {
				const typeValues = filters['productType[]'];
				productTypeContainer.querySelectorAll('input[type="checkbox"]').forEach(function (checkbox) {
					checkbox.checked = typeValues.indexOf(checkbox.value) !== -1;
				});
				productTypeMulti.refresh();
			}
			fieldFilters.forEach(function (fieldFilter) {
				const filterValues = filters['fieldFilter[' + fieldFilter.container.dataset.instance + '][]'];
				if (filterValues && !hasUrlProductType) {
					fieldFilter.container.querySelectorAll('input[type="checkbox"]').forEach(function (checkbox) {
						checkbox.checked = filterValues.indexOf(checkbox.value) !== -1;
					});
					fieldFilter.multi.refresh();
				}
			});
			updateFieldFilterVisibility();
		}
	});

	function reloadTable() { table.reload(); }

	searchInput.addEventListener('input', function () {
		clearTimeout(searchTimer);
		searchTimer = setTimeout(reloadTable, 400);
	});

	povButtons.forEach(function (button) {
		button.addEventListener('click', function () {
			setPovValue(button.dataset.value);
			reloadTable();
		});
	});

	reportModeButtons.forEach(function (button) {
		button.addEventListener('click', function () {
			setReportMode(button.dataset.value);
			reloadTable();
		});
	});

	table.init();
});
{% endjs %}
