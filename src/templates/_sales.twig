{% extends 'best-sellers/_layouts/reports' %}
{% do view.registerTranslations('best-sellers', [
	'Filtered: {label}',
	'Clear filter',
	'Shipping: {method}',
	'Discounted orders',
	'Full-price orders',
	'Discount ID: {id}',
	'Items per order: {bucket}',
	'orders.bulk.downloadPdf',
	'orders.bulk.downloadPdfCount',
	'orders.bulk.selectRowAria',
	'orders.bulk.selectionsResetOnPaginate',
]) %}

{% set title = "Orders"|t('best-sellers') %}
{% set selectedSubnavItem = 'orders' %}
{% set bulkPdfEnabled = enabledPdfs|length > 0 %}

{% block reportContent %}
	{# Filters #}
	<div class="bs-section">
		<div class="bs-filter-bar bs-filter-bar--spaced">
			<div class="bs-multiselect" id="payment-status-multiselect">
				<button type="button" class="bs-multiselect__btn" data-label="{{ 'Payment Status'|t('best-sellers') }}">{{ "Payment Status"|t('best-sellers') }}</button>
				<div class="bs-multiselect__dropdown">
					<label><input type="checkbox" value="paid"{% if 'paid' in selectedPaymentStatuses %} checked{% endif %}> {{ "Paid"|t('best-sellers') }}</label>
					<label><input type="checkbox" value="partial"{% if 'partial' in selectedPaymentStatuses %} checked{% endif %}> {{ "Partial"|t('best-sellers') }}</label>
					<label><input type="checkbox" value="unpaid"{% if 'unpaid' in selectedPaymentStatuses %} checked{% endif %}> {{ "Unpaid"|t('best-sellers') }}</label>
					<label><input type="checkbox" value="overpaid"{% if 'overpaid' in selectedPaymentStatuses %} checked{% endif %}> {{ "Overpaid"|t('best-sellers') }}</label>
				</div>
			</div>
			{% if shippingMethods is defined and shippingMethods|length > 0 %}
				<div class="bs-multiselect" id="shipping-method-multiselect">
					<button type="button" class="bs-multiselect__btn" data-label="{{ 'Shipping'|t('best-sellers') }}">{{ "Shipping"|t('best-sellers') }}</button>
					<div class="bs-multiselect__dropdown">
						{% for method in shippingMethods %}
							<label><input type="checkbox" value="{{ method.method }}"> {{ method.method }}</label>
						{% endfor %}
					</div>
				</div>
			{% endif %}
			<div class="bs-multiselect" id="discount-status-multiselect">
				<button type="button" class="bs-multiselect__btn" data-label="{{ 'Discount'|t('best-sellers') }}">{{ "Discount"|t('best-sellers') }}</button>
				<div class="bs-multiselect__dropdown">
					<label><input type="checkbox" value="discounted"> {{ "Discounted"|t('best-sellers') }}</label>
					<label><input type="checkbox" value="fullPrice"> {{ "Full Price"|t('best-sellers') }}</label>
					{% if topDiscounts is defined and topDiscounts|length > 0 %}
						<hr style="margin: 0.3rem 1rem; border: none; border-top: 1px solid #e0e0e0;">
						{% for discount in topDiscounts %}
							{% if discount.discountId %}
								<label><input type="checkbox" value="discount:{{ discount.discountId }}"> {{ discount.name }}</label>
							{% endif %}
						{% endfor %}
					{% endif %}
				</div>
			</div>
			<div class="bs-filter-bar__item">
				<input type="text" id="orders-search" class="text fullwidth" placeholder="{{ 'Search orders...'|t('best-sellers') }}" autocomplete="off">
			</div>
			<span id="orders-export"></span>
			{% if bulkPdfEnabled %}
				<div id="orders-bulk-actions" class="bs-bulk-actions hidden">
					<button type="button" id="bs-bulk-download-btn" class="btn submit" aria-haspopup="true" aria-expanded="false">
						{{ 'orders.bulk.downloadPdf'|t('best-sellers') }}
					</button>
					<div id="bs-download-pdf-menu" class="bs-bulk-actions__menu hidden">
						<form id="bs-download-pdf-form" method="post" accept-charset="UTF-8" class="bs-download-pdf-form">
							{{ csrfInput() }}
							{{ actionInput('best-sellers/orders/download-pdfs') }}
							<div class="field">
								<div class="heading"><label for="bs-download-pdf-id">{{ 'orders.bulk.pdfLabel'|t('best-sellers') }}</label></div>
								<div class="input">
									<div class="select">
										<select id="bs-download-pdf-id" name="pdfId">
											{% for pdf in enabledPdfs %}
												<option value="{{ pdf.id }}">{{ pdf.name|t('site') }}</option>
											{% endfor %}
										</select>
									</div>
								</div>
							</div>
							<div class="field">
								<div class="heading"><label for="bs-download-pdf-type">{{ 'orders.bulk.downloadTypeLabel'|t('best-sellers') }}</label></div>
								<div class="input">
									<div class="select">
										<select id="bs-download-pdf-type" name="downloadType">
											<option value="zipArchive">{{ 'orders.bulk.zipFile'|t('best-sellers') }}</option>
											<option value="pdfCollated">{{ 'orders.bulk.collatedPdf'|t('best-sellers') }}</option>
										</select>
									</div>
								</div>
							</div>
							<button type="submit" class="btn submit">{{ 'orders.bulk.download'|t('best-sellers') }}</button>
						</form>
					</div>
				</div>
			{% endif %}
		</div>

		{# Loading State #}
		<div id="orders-loading" class="bs-loading">
			<div class="bs-loading__spinner"></div>
			<p class="bs-loading__message">{{ "Rummaging through the order archives..."|t('best-sellers') }}</p>
		</div>

		{% if purchasableFilterLabel %}
			{% set clearUrl = url('best-sellers/orders') %}
			<div class="bs-filter-chip-bar">
				<span class="bs-filter-chip">
					<span class="bs-filter-chip__label">{{ "Filtered to:"|t('best-sellers') }}</span>
					<span class="bs-filter-chip__value">{{ purchasableFilterLabel }}</span>
					<a href="{{ clearUrl }}" class="bs-filter-chip__clear" title="{{ 'Clear filter'|t('best-sellers') }}">×</a>
				</span>
			</div>
		{% endif %}

		{# Orders Table (hidden until loaded) #}
		<div id="orders-container" class="hidden">
			<div id="orders-totals" class="bs-totals-bar" hidden></div>
			<div style="overflow-x: auto;">
				<table class="bs-data-table" id="orders-table">
					<thead>
						<tr>
							{% if bulkPdfEnabled %}
								<th class="bs-data-table--checkbox"><input type="checkbox" id="bs-master-select" aria-label="{{ 'orders.bulk.selectAllAria'|t('best-sellers') }}"></th>
							{% endif %}
							<th data-sort="reference">{{ "Order #"|t('best-sellers') }}</th>
							<th data-sort="dateOrdered">{{ "Date Ordered"|t('best-sellers') }}</th>
							<th data-sort="orderStatusId">{{ "Status"|t('best-sellers') }}</th>
							<th class="bs-data-table--right" data-sort="itemSubtotal">{{ "Item Subtotal"|t('best-sellers') }}</th>
							<th class="bs-data-table--right" data-sort="totalTax">{{ "Tax"|t('best-sellers') }}</th>
							<th class="bs-data-table--right" data-sort="totalDiscount">{{ "Discount"|t('best-sellers') }}</th>
							<th class="bs-data-table--right" data-sort="totalShippingCost">{{ "Shipping"|t('best-sellers') }}</th>
							<th class="bs-data-table--right" data-sort="totalPaid">{{ "Total Paid"|t('best-sellers') }}</th>
							<th class="bs-data-table--right">{{ "Items Sold"|t('best-sellers') }}</th>
							<th data-sort="paidStatus">{{ "Payment"|t('best-sellers') }}</th>
						</tr>
					</thead>
					<tbody id="orders-tbody"></tbody>
				</table>
			</div>

			<div id="orders-pagination" class="bs-pagination"></div>

			<details class="bs-data-notes">
				<summary>{{ "About these numbers"|t('best-sellers') }}</summary>
				<ul>
					<li>{{ "{label} is the order’s <code>itemSubtotal</code>: quantity × sale price across every line item. Sale-price promotions are already baked in; coupon and manual discounts (line-level or order-level) are not subtracted here. They appear in the {discountLabel} column."|t('best-sellers', { label: '<strong>' ~ 'Item Subtotal'|t('best-sellers') ~ '</strong>', discountLabel: '<strong>' ~ 'Discount'|t('best-sellers') ~ '</strong>' })|raw }}</li>
					<li>{{ "{label} sums all Discount adjustments on the order (coupons, manual, line-level and order-level). It does not include sale-price promotions."|t('best-sellers', { label: '<strong>' ~ 'Discount'|t('best-sellers') ~ '</strong>' })|raw }}</li>
					<li>{{ "{label} is the live sum of successful gateway transactions minus refunds. This is the closest figure to what was settled."|t('best-sellers', { label: '<strong>' ~ 'Total Paid'|t('best-sellers') ~ '</strong>' })|raw }}</li>
					<li>{{ "Soft-deleted orders are excluded."|t('best-sellers') }}</li>
					<li>{{ "Dates are bucketed in the site’s timezone ({tz})."|t('best-sellers', { tz: craft.app.getTimeZone() }) }}</li>
				</ul>
			</details>
		</div>
	</div>
{% endblock %}

{% set baseParams = { from: from, to: to, preset: preset } %}
{% if productId %}{% set baseParams = baseParams|merge({ productId: productId }) %}{% endif %}
{% if variantId %}{% set baseParams = baseParams|merge({ variantId: variantId }) %}{% endif %}

{% js %}
document.addEventListener('DOMContentLoaded', function () {
	const searchInput = document.getElementById('orders-search');
	let searchTimer = null;

	const paymentStatusMulti = BestSellersReports.createMultiSelect({
		container: document.getElementById('payment-status-multiselect'),
		onChange: function () { table.reload(); }
	});

	const shippingMethodMulti = BestSellersReports.createMultiSelect({
		container: document.getElementById('shipping-method-multiselect'),
		onChange: function () { table.reload(); }
	});

	const discountStatusMulti = BestSellersReports.createMultiSelect({
		container: document.getElementById('discount-status-multiselect'),
		onChange: function () { table.reload(); }
	});

	{% if bulkPdfEnabled %}
		const selectRowAriaLabel = Craft.t('best-sellers', 'orders.bulk.selectRowAria');
		const bulkDownloadLabel = Craft.t('best-sellers', 'orders.bulk.downloadPdf');
	{% endif %}

	const table = BestSellersReports.createAjaxTable({
		loadingEl: document.getElementById('orders-loading'),
		containerEl: document.getElementById('orders-container'),
		tbodyEl: document.getElementById('orders-tbody'),
		paginationEl: document.getElementById('orders-pagination'),
		totalsEl: document.getElementById('orders-totals'),
		actionUrl: 'best-sellers/orders/orders-data',
		exportUrl: 'best-sellers/orders/export-csv',
		exportContainerEl: document.getElementById('orders-export'),
		baseParams: {{ baseParams|json_encode|raw }},
		defaultSort: 'dateOrdered',
		defaultSortDir: 'desc',
		itemLabel: 'orders',
		emptyMessage: 'No orders found matching your filters.',
		buildRow: function (order) {
			const row = document.createElement('tr');
			row.innerHTML =
				{% if bulkPdfEnabled %}'<td class="bs-data-table--checkbox"><input type="checkbox" name="orderIds[]" value="' + order.id + '" form="bs-download-pdf-form" class="bs-row-select" aria-label="' + selectRowAriaLabel + '"></td>' +{% endif %}
				'<td><a href="' + order.cpEditUrl + '" class="go">' + order.reference + '</a></td>' +
				'<td>' + order.dateOrdered + '</td>' +
				'<td><span class="status ' + order.statusColor + '"></span> ' + order.statusName + '</td>' +
				'<td class="bs-data-table--right">' + order.itemSubtotal + '</td>' +
				'<td class="bs-data-table--right">' + order.totalTax + '</td>' +
				'<td class="bs-data-table--right">' + order.totalDiscount + '</td>' +
				'<td class="bs-data-table--right">' + order.totalShippingCost + '</td>' +
				'<td class="bs-data-table--right">' + order.totalPaid + '</td>' +
				'<td class="bs-data-table--right">' + order.itemsSold + '</td>' +
				'<td>' + order.paidStatusHtml + '</td>';
			return row;
		},
		buildTotalsBar: function (totals) {
			return BestSellersReports.buildTotalsBar(
				'{{ "Filtered Results Total"|t("best-sellers") }}',
				[
					{ label: '{{ "Item Subtotal"|t("best-sellers") }}', value: totals.itemSubtotal },
					{ label: '{{ "Tax"|t("best-sellers") }}', value: totals.totalTax },
					{ label: '{{ "Discount"|t("best-sellers") }}', value: totals.totalDiscount },
					{ label: '{{ "Shipping"|t("best-sellers") }}', value: totals.totalShippingCost },
					{ label: '{{ "Total Paid"|t("best-sellers") }}', value: totals.totalPaid },
					{ label: '{{ "Items"|t("best-sellers") }}', value: totals.itemsSold }
				]
			);
		},
		getFilterParams: function () {
			const params = {};
			const searchValue = searchInput ? searchInput.value.trim() : '';
			if (searchValue) { params.search = searchValue; }
			const paymentStatuses = paymentStatusMulti.getSelected();
			if (paymentStatuses.length > 0) {
				params['paymentStatus[]'] = paymentStatuses;
			} else {
				// Empty-string marker: tells the controller the user explicitly cleared
				// the filter (vs. "never touched", which falls back to the session
				// default of Paid + Partial).
				params['paymentStatus'] = '';
			}
			if (shippingMethodMulti) {
				const shippingMethods = shippingMethodMulti.getSelected();
				if (shippingMethods.length > 0) { params['shippingMethod'] = shippingMethods[0]; }
			}
			if (discountStatusMulti) {
				const discountSelections = discountStatusMulti.getSelected();
				discountSelections.forEach(function (val) {
					if (val.indexOf('discount:') === 0) {
						params['discountId'] = val.substring(9);
					} else {
						params['discountStatus'] = val;
					}
				});
			}
			return params;
		},
		restoreFilterState: function (filters) {
			if (filters.search && searchInput) {
				searchInput.value = filters.search;
			}
			if (filters['paymentStatus[]']) {
				const paymentStatusContainer = document.getElementById('payment-status-multiselect');
				const paymentStatusCheckboxes = paymentStatusContainer.querySelectorAll('input[type="checkbox"]');
				const paymentStatusValues = filters['paymentStatus[]'];
				paymentStatusCheckboxes.forEach(function (checkbox) {
					checkbox.checked = paymentStatusValues.indexOf(checkbox.value) !== -1;
				});
				paymentStatusMulti.refresh();
			}
			if (filters.shippingMethod && shippingMethodMulti) {
				const shippingContainer = document.getElementById('shipping-method-multiselect');
				if (shippingContainer) {
					shippingContainer.querySelectorAll('input[type="checkbox"]').forEach(function (cb) {
						cb.checked = cb.value === filters.shippingMethod;
					});
					shippingMethodMulti.refresh();
				}
			}
			if ((filters.discountStatus || filters.discountId) && discountStatusMulti) {
				const discountContainer = document.getElementById('discount-status-multiselect');
				if (discountContainer) {
					discountContainer.querySelectorAll('input[type="checkbox"]').forEach(function (cb) {
						if (filters.discountStatus && cb.value === filters.discountStatus) {
							cb.checked = true;
						} else if (filters.discountId && cb.value === 'discount:' + filters.discountId) {
							cb.checked = true;
						}
					});
					discountStatusMulti.refresh();
				}
			}
		}
	});

	if (searchInput) {
		searchInput.addEventListener('input', function () {
			clearTimeout(searchTimer);
			searchTimer = setTimeout(function () { table.reload(); }, 400);
		});
	}

	table.init();

	{% if bulkPdfEnabled %}
		const bulkActionsWrapper = document.getElementById('orders-bulk-actions');
		const bulkDownloadBtn = document.getElementById('bs-bulk-download-btn');
		const bulkDownloadMenu = document.getElementById('bs-download-pdf-menu');
		const masterSelectCheckbox = document.getElementById('bs-master-select');
		const ordersTbody = document.getElementById('orders-tbody');
		const ordersPagination = document.getElementById('orders-pagination');

		function updateBulkDownloadState() {
			const rowCheckboxes = ordersTbody.querySelectorAll('.bs-row-select');
			const checkedCount = ordersTbody.querySelectorAll('.bs-row-select:checked').length;
			bulkActionsWrapper.classList.toggle('hidden', checkedCount === 0);
			if (checkedCount === 0) {
				bulkDownloadMenu.classList.add('hidden');
				bulkDownloadBtn.setAttribute('aria-expanded', 'false');
			}
			bulkDownloadBtn.textContent = checkedCount === 0
				? bulkDownloadLabel
				: Craft.t('best-sellers', 'orders.bulk.downloadPdfCount', { count: checkedCount });
			masterSelectCheckbox.checked = rowCheckboxes.length > 0 && checkedCount === rowCheckboxes.length;
			masterSelectCheckbox.indeterminate = checkedCount > 0 && checkedCount < rowCheckboxes.length;
		}

		bulkDownloadBtn.addEventListener('click', function (event) {
			event.stopPropagation();
			const willOpen = bulkDownloadMenu.classList.contains('hidden');
			bulkDownloadMenu.classList.toggle('hidden');
			bulkDownloadBtn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
		});

		document.addEventListener('click', function (event) {
			if (bulkDownloadMenu.classList.contains('hidden')) {
				return;
			}
			if (bulkDownloadMenu.contains(event.target) || event.target === bulkDownloadBtn) {
				return;
			}
			bulkDownloadMenu.classList.add('hidden');
			bulkDownloadBtn.setAttribute('aria-expanded', 'false');
		});

		masterSelectCheckbox.addEventListener('change', function () {
			const checked = masterSelectCheckbox.checked;
			ordersTbody.querySelectorAll('.bs-row-select').forEach(function (checkbox) {
				checkbox.checked = checked;
			});
			updateBulkDownloadState();
		});

		ordersTbody.addEventListener('change', function (event) {
			if (event.target.classList.contains('bs-row-select')) {
				updateBulkDownloadState();
			}
		});

		// Selections are per-page only. Pagination replaces the tbody, so warn
		// the user when they leave a page with active selections.
		ordersPagination.addEventListener('click', function (event) {
			const button = event.target.closest('button');
			if (button === null || button.classList.contains('bs-export-btn')) {
				return;
			}
			const hasSelections = ordersTbody.querySelectorAll('.bs-row-select:checked').length > 0;
			if (hasSelections) {
				Craft.cp.displayNotice(Craft.t('best-sellers', 'orders.bulk.selectionsResetOnPaginate'));
			}
		});

		// AJAX reload replaces tbody contents, so reset master + button after each render
		new MutationObserver(updateBulkDownloadState).observe(ordersTbody, { childList: true });
	{% endif %}

	// Pre-check dropdowns from URL params (for cross-page filter links)
	try {
		const urlParams = new URLSearchParams(window.location.search);
		const urlShipping = urlParams.get('shippingMethod');
		const urlDiscountStatus = urlParams.get('discountStatus');
		const urlDiscountId = urlParams.get('discountId');

		if (urlShipping && shippingMethodMulti) {
			const shipContainer = document.getElementById('shipping-method-multiselect');
			if (shipContainer) {
				shipContainer.querySelectorAll('input[type="checkbox"]').forEach(function (cb) {
					cb.checked = cb.value === urlShipping;
				});
				shippingMethodMulti.refresh();
			}
		}
		if ((urlDiscountStatus || urlDiscountId) && discountStatusMulti) {
			const discContainer = document.getElementById('discount-status-multiselect');
			if (discContainer) {
				discContainer.querySelectorAll('input[type="checkbox"]').forEach(function (cb) {
					if (urlDiscountStatus && cb.value === urlDiscountStatus) {
						cb.checked = true;
					} else if (urlDiscountId && cb.value === 'discount:' + urlDiscountId) {
						cb.checked = true;
					}
				});
				discountStatusMulti.refresh();
			}
		}
	} catch (e) {
		// URLSearchParams not supported
	}
});
{% endjs %}
