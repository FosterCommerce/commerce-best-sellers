{% extends 'best-sellers/_layouts/reports' %}

{% set title = "Transactions"|t('best-sellers') %}
{% set selectedSubnavItem = 'transactions' %}

{% set storeCurrencyCode = craft.commerce.stores.primaryStore.currency.code ?? 'USD' %}

{% block reportContent %}
	<div class="bs-section">
		<div class="bs-filter-bar bs-filter-bar--spaced">
			<div class="bs-multiselect" id="transaction-type-multiselect">
				<button type="button" class="bs-multiselect__btn" data-label="{{ 'Type'|t('best-sellers') }}">{{ "Type"|t('best-sellers') }}</button>
				<div class="bs-multiselect__dropdown">
					<label><input type="checkbox" value="capture"{% if 'capture' in selectedTypes %} checked{% endif %}> {{ "Capture"|t('best-sellers') }}</label>
					<label><input type="checkbox" value="purchase"{% if 'purchase' in selectedTypes %} checked{% endif %}> {{ "Purchase"|t('best-sellers') }}</label>
					<label><input type="checkbox" value="refund"{% if 'refund' in selectedTypes %} checked{% endif %}> {{ "Refund"|t('best-sellers') }}</label>
					<label><input type="checkbox" value="authorize"{% if 'authorize' in selectedTypes %} checked{% endif %}> {{ "Authorize"|t('best-sellers') }}</label>
				</div>
			</div>

			<div class="bs-multiselect" id="transaction-status-multiselect">
				<button type="button" class="bs-multiselect__btn" data-label="{{ 'Status'|t('best-sellers') }}">{{ "Status"|t('best-sellers') }}</button>
				<div class="bs-multiselect__dropdown">
					<label><input type="checkbox" value="success"{% if 'success' in selectedStatuses %} checked{% endif %}> {{ "Success"|t('best-sellers') }}</label>
					<label><input type="checkbox" value="failed"{% if 'failed' in selectedStatuses %} checked{% endif %}> {{ "Failed"|t('best-sellers') }}</label>
					<label><input type="checkbox" value="pending"{% if 'pending' in selectedStatuses %} checked{% endif %}> {{ "Pending"|t('best-sellers') }}</label>
					<label><input type="checkbox" value="processing"{% if 'processing' in selectedStatuses %} checked{% endif %}> {{ "Processing"|t('best-sellers') }}</label>
					<label><input type="checkbox" value="redirect"{% if 'redirect' in selectedStatuses %} checked{% endif %}> {{ "Redirect"|t('best-sellers') }}</label>
				</div>
			</div>

			{% if gateways is defined and gateways|length > 0 %}
				<div class="bs-multiselect" id="transaction-gateway-multiselect">
					<button type="button" class="bs-multiselect__btn" data-label="{{ 'Gateway'|t('best-sellers') }}">{{ "Gateway"|t('best-sellers') }}</button>
					<div class="bs-multiselect__dropdown">
						{% for gateway in gateways %}
							<label><input type="checkbox" value="{{ gateway.id }}"> {{ gateway.name }}</label>
						{% endfor %}
					</div>
				</div>
			{% endif %}

			<div id="transaction-order-date-range" class="bs-order-date-range">
				<span class="light bs-order-date-range__label">{{ "Order date"|t('best-sellers') }}</span>
				<input type="hidden" id="transactions-order-from" value="{{ orderFrom }}">
				<input type="hidden" id="transactions-order-to" value="{{ orderTo }}">
				<div class="bs-order-date-range__controls">
					<div data-order-date-range-picker></div>
					<button type="button" class="btn" id="transactions-order-date-clear" title="{{ 'Clear order date filter'|t('best-sellers') }}"{% if not orderFrom and not orderTo %} hidden{% endif %}>×</button>
				</div>
			</div>

			<div class="bs-filter-bar__item">
				<input type="text" id="transactions-search" class="text fullwidth" placeholder="{{ 'Search by order #, email, reference…'|t('best-sellers') }}" autocomplete="off">
			</div>

			<span id="transactions-export"></span>
		</div>

		<div id="transactions-loading" class="bs-loading">
			<div class="bs-loading__spinner"></div>
			<p class="bs-loading__message">{{ "Reconciling the books..."|t('best-sellers') }}</p>
		</div>

		<div id="transactions-container" class="hidden">
			<div id="transactions-totals" class="bs-totals-bar" hidden></div>
			<div class="bs-table-scroll">
				<table class="bs-data-table" id="transactions-table">
					<thead>
						<tr>
							<th data-sort="dateCreated">{{ "Date"|t('best-sellers') }}</th>
							<th data-sort="type">{{ "Type"|t('best-sellers') }}</th>
							<th data-sort="status">{{ "Status"|t('best-sellers') }}</th>
							<th data-sort="gateway">{{ "Gateway"|t('best-sellers') }}</th>
							<th class="bs-data-table--right" data-sort="amount">{{ "Amount"|t('best-sellers') }}</th>
							<th data-sort="orderReference">{{ "Order #"|t('best-sellers') }}</th>
							<th data-sort="orderDateOrdered">{{ "Order Date"|t('best-sellers') }}</th>
							<th>{{ "Email"|t('best-sellers') }}</th>
							<th>{{ "Reference"|t('best-sellers') }}</th>
						</tr>
					</thead>
					<tbody id="transactions-tbody"></tbody>
				</table>
			</div>

			<div id="transactions-pagination" class="bs-pagination"></div>

			<details class="bs-data-notes">
				<summary>{{ "About these numbers"|t('best-sellers') }}</summary>
				<ul>
					<li>{{ "The header date picker bounds the transaction’s {column}, not the order’s {orderColumn}. Refunds appear on the day the refund was processed, not when the original order was placed."|t('best-sellers', { column: '<code>dateCreated</code>', orderColumn: '<code>dateOrdered</code>' })|raw }}</li>
					<li>{{ "The {orderDateLabel} filter is an additional intersection on the order’s {orderColumn}. Set both to answer questions like “refunds processed in May for orders placed in March.” Leave it empty to filter by transaction date alone."|t('best-sellers', { orderDateLabel: '<strong>' ~ 'Order date'|t('best-sellers') ~ '</strong>', orderColumn: '<code>dateOrdered</code>' })|raw }}</li>
					<li>{{ "Refunds are shown as negative amounts. {netLabel} = {capturedLabel} − {refundedLabel} for the filtered rows."|t('best-sellers', { netLabel: '<strong>' ~ 'Net'|t('best-sellers') ~ '</strong>', capturedLabel: '<strong>' ~ 'Captured'|t('best-sellers') ~ '</strong>', refundedLabel: '<strong>' ~ 'Refunded'|t('best-sellers') ~ '</strong>' })|raw }}</li>
					<li>{{ "Only transactions recorded in the store currency ({code}) are included. Multi-currency transactions, if any, are excluded."|t('best-sellers', { code: storeCurrencyCode }) }}</li>
					<li>{{ "{authorizeLabel} rows are not money movement on their own. Enabling the {authorizeLabel} type filter will include them in {capturedLabel}, which double-counts the matching {captureLabel}."|t('best-sellers', { authorizeLabel: '<strong>' ~ 'Authorize'|t('best-sellers') ~ '</strong>', capturedLabel: '<strong>' ~ 'Captured'|t('best-sellers') ~ '</strong>', captureLabel: '<strong>' ~ 'Capture'|t('best-sellers') ~ '</strong>' })|raw }}</li>
					<li>{{ "Transactions for soft-deleted orders are excluded."|t('best-sellers') }}</li>
					<li>{{ "Dates are bucketed in the site’s timezone ({tz})."|t('best-sellers', { tz: craft.app.getTimeZone() }) }}</li>
				</ul>
			</details>
		</div>
	</div>
{% endblock %}

{% set baseParams = { from: from, to: to, preset: preset } %}

{% js %}
document.addEventListener('DOMContentLoaded', function () {
	const searchInput = document.getElementById('transactions-search');
	let searchTimer = null;

	const typeMulti = BestSellersReports.createMultiSelect({
		container: document.getElementById('transaction-type-multiselect'),
		onChange: function () { table.reload(); }
	});

	const statusMulti = BestSellersReports.createMultiSelect({
		container: document.getElementById('transaction-status-multiselect'),
		onChange: function () { table.reload(); }
	});

	const gatewayContainer = document.getElementById('transaction-gateway-multiselect');
	const gatewayMulti = gatewayContainer ? BestSellersReports.createMultiSelect({
		container: gatewayContainer,
		onChange: function () { table.reload(); }
	}) : null;

	const orderFromInput = document.getElementById('transactions-order-from');
	const orderToInput = document.getElementById('transactions-order-to');
	const orderDateClearBtn = document.getElementById('transactions-order-date-clear');
	const orderPickerContainer = document.querySelector('[data-order-date-range-picker]');
	let orderPickerInitialized = false;
	let orderPickerInstance = null;

	function parseDateString(value) {
		if (!value) { return null; }
		const parts = value.split('-');
		if (parts.length !== 3) { return null; }
		const year = parseInt(parts[0], 10);
		const month = parseInt(parts[1], 10);
		const day = parseInt(parts[2], 10);
		if (isNaN(year) || isNaN(month) || isNaN(day)) { return null; }
		return new Date(year, month - 1, day);
	}

	function formatDateString(date) {
		if (!date) { return ''; }
		const month = String(date.getMonth() + 1).padStart(2, '0');
		const day = String(date.getDate()).padStart(2, '0');
		return date.getFullYear() + '-' + month + '-' + day;
	}

	function syncOrderDateClearVisibility() {
		if (!orderDateClearBtn) { return; }
		const hasValue = (orderFromInput && orderFromInput.value) || (orderToInput && orderToInput.value);
		orderDateClearBtn.hidden = !hasValue;
	}

	const table = BestSellersReports.createAjaxTable({
		loadingEl: document.getElementById('transactions-loading'),
		containerEl: document.getElementById('transactions-container'),
		tbodyEl: document.getElementById('transactions-tbody'),
		paginationEl: document.getElementById('transactions-pagination'),
		totalsEl: document.getElementById('transactions-totals'),
		actionUrl: 'best-sellers/transactions/transactions-data',
		exportUrl: 'best-sellers/transactions/export-csv',
		exportContainerEl: document.getElementById('transactions-export'),
		baseParams: {{ baseParams|json_encode|raw }},
		defaultSort: 'dateCreated',
		defaultSortDir: 'desc',
		itemLabel: 'transactions',
		emptyMessage: 'No transactions found matching your filters.',
		buildRow: function (transaction) {
			const row = document.createElement('tr');
			const orderCell = transaction.cpEditUrl
				? '<td><a href="' + transaction.cpEditUrl + '" class="go">' + (transaction.orderReference || '') + '</a></td>'
				: '<td>' + (transaction.orderReference || '') + '</td>';
			const amountClass = transaction.isRefund ? 'bs-data-table--right bs-amount--refund' : 'bs-data-table--right';
			row.innerHTML =
				'<td>' + transaction.dateCreated + '</td>' +
				'<td>' + transaction.type + '</td>' +
				'<td>' + transaction.status + '</td>' +
				'<td>' + transaction.gateway + '</td>' +
				'<td class="' + amountClass + '">' + transaction.amount + '</td>' +
				orderCell +
				'<td>' + (transaction.orderDateOrdered || '') + '</td>' +
				'<td>' + transaction.email + '</td>' +
				'<td>' + transaction.reference + '</td>';
			return row;
		},
		buildTotalsBar: function (totals) {
			return BestSellersReports.buildTotalsBar(
				'{{ "Filtered Results Total"|t("best-sellers") }}',
				[
					{ label: '{{ "Captured"|t("best-sellers") }}', value: totals.captured },
					{ label: '{{ "Refunded"|t("best-sellers") }}', value: totals.refunded },
					{ label: '{{ "Net"|t("best-sellers") }}', value: totals.net }
				]
			);
		},
		getFilterParams: function () {
			const params = {};
			const searchValue = searchInput ? searchInput.value.trim() : '';
			if (searchValue) { params.search = searchValue; }

			const types = typeMulti.getSelected();
			if (types.length > 0) {
				params['type[]'] = types;
			} else {
				params['type'] = '';
			}

			const statuses = statusMulti.getSelected();
			if (statuses.length > 0) {
				params['status[]'] = statuses;
			} else {
				params['status'] = '';
			}

			if (gatewayMulti) {
				const gateways = gatewayMulti.getSelected();
				if (gateways.length > 0) {
					params['gatewayId[]'] = gateways;
				}
			}

			const orderFromValue = orderFromInput ? orderFromInput.value.trim() : '';
			if (orderFromValue) { params.orderFrom = orderFromValue; }
			const orderToValue = orderToInput ? orderToInput.value.trim() : '';
			if (orderToValue) { params.orderTo = orderToValue; }

			return params;
		},
		restoreFilterState: function (filters) {
			if (filters.search && searchInput) {
				searchInput.value = filters.search;
			}
			if (filters['type[]']) {
				const typeContainer = document.getElementById('transaction-type-multiselect');
				const typeCheckboxes = typeContainer.querySelectorAll('input[type="checkbox"]');
				const typeValues = filters['type[]'];
				typeCheckboxes.forEach(function (checkbox) {
					checkbox.checked = typeValues.indexOf(checkbox.value) !== -1;
				});
				typeMulti.refresh();
			}
			if (filters['status[]']) {
				const statusContainer = document.getElementById('transaction-status-multiselect');
				const statusCheckboxes = statusContainer.querySelectorAll('input[type="checkbox"]');
				const statusValues = filters['status[]'];
				statusCheckboxes.forEach(function (checkbox) {
					checkbox.checked = statusValues.indexOf(checkbox.value) !== -1;
				});
				statusMulti.refresh();
			}
			if (filters['gatewayId[]'] && gatewayMulti) {
				const gatewayContainerEl = document.getElementById('transaction-gateway-multiselect');
				if (gatewayContainerEl) {
					const gatewayCheckboxes = gatewayContainerEl.querySelectorAll('input[type="checkbox"]');
					const gatewayValues = filters['gatewayId[]'];
					gatewayCheckboxes.forEach(function (checkbox) {
						checkbox.checked = gatewayValues.indexOf(checkbox.value) !== -1;
					});
					gatewayMulti.refresh();
				}
			}
			if (filters.orderFrom && orderFromInput) {
				orderFromInput.value = filters.orderFrom;
			}
			if (filters.orderTo && orderToInput) {
				orderToInput.value = filters.orderTo;
			}
			syncOrderDateClearVisibility();
		}
	});

	if (searchInput) {
		searchInput.addEventListener('input', function () {
			clearTimeout(searchTimer);
			searchTimer = setTimeout(function () { table.reload(); }, 400);
		});
	}

	if (orderDateClearBtn) {
		orderDateClearBtn.addEventListener('click', function () {
			if (orderFromInput) { orderFromInput.value = ''; }
			if (orderToInput) { orderToInput.value = ''; }
			syncOrderDateClearVisibility();
			if (orderPickerContainer && Craft.ui && Craft.ui.createDateRangePicker) {
				orderPickerInitialized = false;
				orderPickerContainer.innerHTML = '';
				orderPickerInstance = Craft.ui.createDateRangePicker({
					selected: '',
					onChange: function (start, end) {
						if (!orderPickerInitialized) { return; }
						orderFromInput.value = formatDateString(start);
						orderToInput.value = formatDateString(end);
						syncOrderDateClearVisibility();
						table.reload();
					}
				});
				orderPickerInstance.appendTo(orderPickerContainer);
				orderPickerInitialized = true;
			}
			table.reload();
		});
	}

	table.init();

	// Build the order-date picker after table.init() so it reflects orderFrom /
	// orderTo restored from sessionStorage. The header date-range picker submits a
	// full page reload that drops these AJAX-only params, leaving the hidden inputs
	// empty until restoreFilterState refills them.
	if (orderPickerContainer && Craft.ui && Craft.ui.createDateRangePicker) {
		const pickerOptions = {
			selected: (orderFromInput.value || orderToInput.value) ? 'custom' : '',
			onChange: function (start, end, handle) {
				if (!orderPickerInitialized) { return; }
				orderFromInput.value = formatDateString(start);
				orderToInput.value = formatDateString(end);
				syncOrderDateClearVisibility();
				table.reload();
			}
		};
		const initialStart = parseDateString(orderFromInput.value);
		const initialEnd = parseDateString(orderToInput.value);
		if (initialStart) { pickerOptions.startDate = initialStart; }
		if (initialEnd) { pickerOptions.endDate = initialEnd; }

		orderPickerInstance = Craft.ui.createDateRangePicker(pickerOptions);
		orderPickerInstance.appendTo(orderPickerContainer);
		orderPickerInitialized = true;
	}
});
{% endjs %}
